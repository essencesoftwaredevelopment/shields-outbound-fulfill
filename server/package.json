{
    "name": "shields-outbound-server",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node --watch src/index.js",
        "dev:all": "bash scripts/dev-all.sh",
        "worker": "node src/worker/queueWorker.js",
        "instantly:worker": "node src/worker/instantlySyncWorker.js",
        "instantly:sync": "node src/scripts/run-instantly-sync-once.js",
        "instantly:stop-all": "node src/scripts/stop-all-instantly-syncs.js",
        "followups:worker": "node src/worker/followUpWorker.js",
        "followups:send-once": "node src/scripts/run-follow-ups-once.js",
        "personalizer:local": "node src/scripts/run-personalizer-local.js",
        "shopping-audit:spike": "node src/scripts/serper-shopping-spike.js",
        "shopping-audit:report": "node src/scripts/shopping-audit-batch-report.js",
        "db:ping": "node scripts/db-ping.js",
        "db:migrate:firestore-users-clients": "node src/scripts/migrate-firestore-to-sql/migrate-users-clients.js",
        "db:migration:capture-baseline": "bash scripts/migration/capture-cloudsql-baseline.sh",
        "db:migration:export-data": "bash scripts/migration/export-cloudsql-data.sh",
        "db:migration:import-target": "bash scripts/migration/import-into-supabase.sh",
        "db:migration:compare-parity": "bash scripts/migration/compare-parity.sh",
        "db:migration:validate-target": "bash scripts/migration/validate-target.sh",
        "test": "node --test \"src/utils/__tests__/*.test.js\" \"src/services/**/__tests__/*.test.js\""
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.106.2",
        "@upstash/ratelimit": "^2.0.8",
        "@upstash/redis": "^1.38.0",
        "axios": "^1.7.7",
        "cors": "^2.8.5",
        "csv-parse": "^5.5.4",
        "csv-parser": "^3.0.0",
        "csv-stringify": "^6.5.2",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "firebase-admin": "^13.6.0",
        "multer": "^1.4.5-lts.1",
        "ngrok": "5.0.0-beta.2",
        "node-fetch": "^3.3.2",
        "openai": "^4.73.1",
        "p-limit": "^5.0.0",
        "pg": "^8.22.0",
        "playwright": "^1.61.1",
        "stripe": "^14.24.0",
        "ws": "^8.21.0"
    }
}
